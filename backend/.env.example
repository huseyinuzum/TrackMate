# Veritabanı Bağlantısı
# Yerel kullanım için: postgresql+asyncpg://USER:PASSWORD@localhost:5432/trackmate
# Neon.tech (bulut) için: postgresql+asyncpg://USER:PASSWORD@HOST/trackmate?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/trackmate

# JWT Ayarları
SECRET_KEY=super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Uygulama
APP_NAME=TrackMate
APP_VERSION=0.1.0
DEBUG=True

# Yapay Zeka (NLP) - Gemini
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Harita ve Lokasyon (Geoapify)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
